# LOCAL DEVELOPMENT ONLY — never commit real secrets.
NODE_ENV=development
API_PORT=3001
DATABASE_URL=postgresql://dazat:dazat_local_only@localhost:5432/dazat_mobility
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info

# Phase 0.3 identity verification/session settings.
# Replace with a secret-manager value in any deployed environment.
CONTACT_VERIFICATION_PEPPER=local-development-only-change-this-pepper-32chars-minimum
CONTACT_VERIFICATION_TTL_MINUTES=10
CONTACT_VERIFICATION_RESEND_SECONDS=30
CONTACT_VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_DELIVERY_MODE=development_console
DAZAT_DEV_EXPOSE_VERIFICATION_CODE=true
SESSION_TTL_MINUTES=60

# Phase 0.3 quote slice. This is a NON-COMMERCIAL development fixture only.
# Production must keep PRICING_MODE=disabled until an approved versioned tariff/policy is configured.
PRICING_MODE=development_fixture
DEVELOPMENT_QUOTE_AMOUNT_MINOR=1000
DEVELOPMENT_QUOTE_CURRENCY=GBP
QUOTE_TTL_MINUTES=15
DISPATCH_OFFER_TTL_SECONDS=30
DISPATCH_OFFER_WAVE_SIZE=3
DISPATCH_LOCATION_MAX_AGE_SECONDS=90
DISPATCH_MINIMUM_LOCATION_CONFIDENCE=0.5

# Phase 0.5 assignment-to-pickup and protected RideCheck settings.
# Keep the RideCheck pepper distinct and secrets-managed outside local development.
JOURNEY_LOCATION_MAX_AGE_SECONDS=60
JOURNEY_LOCATION_MAXIMUM_FUTURE_SKEW_SECONDS=15
JOURNEY_LOCATION_MAXIMUM_ACCURACY_METRES=75
JOURNEY_LOCATION_MINIMUM_CONFIDENCE=0.7
JOURNEY_ARRIVAL_RADIUS_METRES=200
RIDECHECK_PEPPER=local-development-only-change-this-ridecheck-pepper-32chars-minimum
RIDECHECK_TTL_MINUTES=10
RIDECHECK_MAXIMUM_ATTEMPTS=5

# Phase 0.6 active Journey monitoring and governed completion defaults.
ACTIVE_JOURNEY_MAXIMUM_PLAUSIBLE_SPEED_MPS=75
JOURNEY_ARRIVING_RADIUS_METRES=1000
JOURNEY_COMPLETION_RADIUS_METRES=250

# Phase 0.7 Finance foundation. No other value is accepted until provider, legal,
# accounting, security and operational controls have been approved.
PAYMENT_PROVIDER_MODE=disabled

# Phase 0.12 client/server state reconciliation. This labels stale state; it does not
# auto-execute queued safety or Journey commands.
DRIVER_CONNECTIVITY_FRESHNESS_SECONDS=60

# Phase 0.13 unified Communications Core. No other value is accepted until
# providers, templates, consent/fallback/retention policy and operations are approved.
COMMUNICATION_PROVIDER_MODE=disabled

# Phase 0.14 telephone/voice foundation. Both execution modes fail closed.
TELEPHONY_PROVIDER_MODE=disabled
VOICE_ASSISTANT_MODE=disabled

# Phase 0.15 omnichannel operations foundation. Staff mutation and scenario execution
# remain disabled until permissions, isolated fixtures and operational controls are approved.
CONTACT_CENTRE_MUTATION_MODE=disabled
COMMUNICATIONS_SCENARIO_MODE=disabled

# Phase 0.16 Communications Engine final closure. Source modelling and recipient-scoped
# reads do not enable production commands, provider bypass or launch-gate execution.
COMMUNICATIONS_CLOSURE_MODE=disabled
