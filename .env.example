# LOCAL DEVELOPMENT ONLY — never commit real secrets.
NODE_ENV=development
API_PORT=3001
DATABASE_URL=postgresql://dazat:dazat_local_only@localhost:5432/dazat_mobility
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info

# Phase 0.3 identity verification/session settings.
# Replace with a secret-manager value in any deployed environment.
CONTACT_VERIFICATION_PEPPER=local-development-only-change-this-pepper-32chars-minimum
CONTACT_VERIFICATION_TTL_MINUTES=10
CONTACT_VERIFICATION_RESEND_SECONDS=30
CONTACT_VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_DELIVERY_MODE=development_console
DAZAT_DEV_EXPOSE_VERIFICATION_CODE=true
SESSION_TTL_MINUTES=60

# Phase 0.3 quote slice. This is a NON-COMMERCIAL development fixture only.
# Production must keep PRICING_MODE=disabled until an approved versioned tariff/policy is configured.
PRICING_MODE=development_fixture
DEVELOPMENT_QUOTE_AMOUNT_MINOR=1000
DEVELOPMENT_QUOTE_CURRENCY=GBP
QUOTE_TTL_MINUTES=15
